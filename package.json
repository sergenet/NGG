{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:data": "node scripts/validate-catalog.mjs && node scripts/validate-truthmode.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate:data && npm run lint && npm run typecheck",
    "build": "npm run validate:data && next build && python engine/sitemap_generator.py && python engine/rss_generator.py && python engine/generate_pinterest_feed.py",
    "start": "next start",
    "lint": "eslint src",
    "report:traffic": "node scripts/build-traffic-report.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
