RedirectMatch 301 ^/product/levitating-globe-lamp/?$ /shop/desk-toys-novelty-gifts/
RedirectMatch 301 ^/product/dima-eyewear-blue-light-blocking-computer-glasses/?$ /home-office/essential-desk-upgrades/
RedirectMatch 301 ^/product/elgato-prompter/?$ /gifts/video-call-gifts/
RedirectMatch 301 ^/product/logitech-ergo-k860-wireless-keyboard/?$ /home-office/essential-desk-upgrades/
RedirectMatch 301 ^/product/anker-555-usb-c-hub-8-in-1/?$ /home-office/essential-desk-upgrades/
RedirectMatch 301 ^/product/caldigit-ts4-thunderbolt-4-dock/?$ /home-office/essential-desk-upgrades/
RedirectMatch 301 ^/product/samsung-t7-shield-1tb/?$ /home-office/essential-desk-upgrades/
