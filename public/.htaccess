RedirectMatch 301 ^/product/hamilton-beach-flexbrew-coffee-maker/?$ /shop/kitchen/
RedirectMatch 301 ^/product/zyliss-e900010u-viral-peeler/?$ /shop/kitchen/
RedirectMatch 301 ^/product/furbo-360-dog-camera/?$ /shop/pet-tech/
RedirectMatch 301 ^/product/infinity-fidget-cube/?$ /shop/desk-toys-novelty-gifts/
RedirectMatch 301 ^/product/smootherpro-bolt-action-brass-pen/?$ /shop/desk-toys-novelty-gifts/
RedirectMatch 301 ^/product/qipecedm-4-pcs-ribbed-coupe-glasses-10-oz-vintage-cocktail-coupe-glasses-set-unique-martini-glass-classic-cocktail-galssware-bar-drinking-glasses-set-pefect-for-cocktail-wine-champagne-gif/?$ /shop/kitchen/

# The comparison section is gone and nothing replaced it, so it lands on the
# full catalogue instead of dying as a 410 while it still earns impressions.
RedirectMatch 301 ^/comparisons/?$ /shop/all/

# /audio/ is a WordPress-era file that only survives on the server: it is not
# in the build, not in the sitemap, and it still earns impressions under a 2026
# title that no current catalogue product supports. Nothing replaced it, so it
# goes to the category that serves the same intent rather than dying.
RedirectMatch 301 ^/audio(/.*)?$ /shop/home-entertainment/

# The expired sale page has no current equivalent at all.
RewriteRule ^deals/amazon-big-spring-sale-2026-the-best-tech-gadget-deals/?$ - [G,L]
RewriteRule ^reviews/?$ - [G,L]

# Retired WordPress product and feed URLs have no equivalent current page.
# Return 410 so crawlers stop retrying them instead of treating them as soft 404s.
RewriteRule ^product/[^/]+/feed/?$ - [G,L]
RewriteCond %{DOCUMENT_ROOT}/product/$1/index.html !-f
RewriteRule ^product/([^/]+)/?$ - [G,L]

# Expired or administrative WordPress-era routes should leave the index.
Redirect gone /my-account/
RedirectMatch gone ^/wp-content/.*$

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # AdSense needs its own hosts in script-src (the loader), frame-src (the ad
  # iframe), connect-src (beacon/impression calls) and img-src (creative).
  # analytics.google.com is the GA4 collect endpoint — without it every pageview
  # was refused by CSP and the traffic numbers stayed empty.
  # www.recaptcha.net is the reCAPTCHA host the EmailOctopus newsletter embed
  # loads; without it the form showed "couldn't load reCAPTCHA" and nobody could
  # subscribe.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.googleadservices.com https://adservice.google.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://s.pinimg.com https://cdn.geniuslink.com https://eomail5.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://gallery.eo.page; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://eomail5.com https://www.google.com https://ct.pinterest.com https://www.recaptcha.net; frame-src https://www.google.com https://*.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.googleadservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.recaptcha.net; base-uri 'self'; form-action 'self' https://eomail5.com; frame-ancestors 'self'; upgrade-insecure-requests"

  # Build assets live under /_next/static/ with a content hash in the filename,
  # so they can be cached for a year. mod_expires is declared further down but is
  # not enabled on this LiteSpeed host (responses carried neither Expires nor
  # Cache-Control), so set the header directly. Both modules are guarded: if
  # either is missing the assets simply stay uncached instead of returning 500.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" NGG_IMMUTABLE_ASSET
    Header set Cache-Control "public, max-age=31536000, immutable" env=NGG_IMMUTABLE_ASSET
  </IfModule>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
