RedirectMatch 301 ^/product/taotronics-led-desk-lamp/?$ /shop/home-office/
RedirectMatch 301 ^/product/lepower-metal-desk-lamp/?$ /shop/home-office/
RedirectMatch 301 ^/product/eppiebasic-led-desk-lamp/?$ /shop/home-office/
